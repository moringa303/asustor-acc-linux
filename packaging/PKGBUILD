# Maintainer: your name <you@example.com>
# AUR package for Asustor Control Center for Linux. Update url/source after publishing
# the GitHub repository, then run updpkgsums.
pkgname=asustor-acc-linux
pkgver=1.7.1
pkgrel=1
pkgdesc="Unofficial Linux version of ASUSTOR Control Center (NAS discovery, ADM launcher, WOL)"
arch=(x86_64)
url="https://github.com/moringa303/asustor-acc-linux"
license=(MIT)
depends=(gtk4 python-gobject xdg-utils)
optdepends=('gvfs-smb: open shared folders from GNOME, Cinnamon and XFCE file managers'
            'kio-extras: open shared folders from Dolphin'
            'webkitgtk-6.0: open the compatibility list and ADM inside the app instead of the browser'
            'libsecret: keep the ADM password for Restart and Shut down in the keyring')
makedepends=(go)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X main.version=$pkgver" -o acc ./cmd/acc
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 acc "$pkgdir/usr/bin/acc"
  install -Dm755 gui/acc-gui.py "$pkgdir/usr/bin/acc-gui"
  sed -i "s/^GUI_VERSION = \"dev\"/GUI_VERSION = \"$pkgver\"/" "$pkgdir/usr/bin/acc-gui"
  for s in 48 64 128 256 512; do
    install -Dm644 "assets/icon-$s.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/io.github.moringa303.AsustorAcc.png"
  done
  install -Dm644 packaging/io.github.moringa303.AsustorAcc.desktop \
    "$pkgdir/usr/share/applications/io.github.moringa303.AsustorAcc.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
